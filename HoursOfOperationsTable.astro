  Types:
-------------------
type Day = 
    | 'Monday' 
    | 'Tuesday' 
    | 'Wednesday' 
    | 'Thursday' 
    | 'Friday' 
    | 'Saturday' 
    | 'Sunday' 
    | 'Holidays';

type Time = { 
    time: string;
    period: 'AM' | 'PM';
};

type WorkHours = {
    startTime: Time;
    endTime: Time;
};

export type HoursOfOperation = {
    day: Day;
    time: 'Closed' | WorkHours;
};


